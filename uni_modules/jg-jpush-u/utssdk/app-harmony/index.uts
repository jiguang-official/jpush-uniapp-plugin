

/* 引入 interface.uts 文件中定义的变量 */
import { PushServiceResult, LiveActivityResult, LiveActivityPushTokenParams, LiveActivityPushToStartTokenParams, EventCallBackParams } from '../interface.uts';

/* 引入 unierror.uts 文件中定义的变量 */



import { CallBackMsgUni, getCachedRid, setCachedRid } from './callback.uts';



import { common, Want, AbilityConstant } from '@kit.AbilityKit';
import { pushCommon, RemoteNotificationExtensionAbility } from '@kit.PushKit';

import {
	JMessage,
	JMessageExtra,
	JPushInterface,
	JCollectControl
} from '@jg/push';

const TAG = "JPUSH-uni-"
let APP_KEY : string | undefined = undefined
let MY_WANT_ARRAY : Want[] = []
let IS_INIT : boolean = false
let upgradeGeneration: number = 0
let activeCallback: CallBackMsgUni | null = null
let callbackIdentity: number = 0
function bridgeError(generation: number, identity: number): void {
  if (generation == upgradeGeneration && identity == callbackIdentity) activeCallback?.emitBridgeError()
}
function consume<T>(promise: Promise<T>): void {
  const generation = upgradeGeneration
  const identity = callbackIdentity
  promise.catch(() => { bridgeError(generation,identity) })
}
export function clearUpgradeCallbacks(): void { upgradeGeneration += 1; callbackIdentity += 1; activeCallback?.dispose(); activeCallback = null }

// 获取应用上下文
function getContext() : common.ApplicationContext {
	return UTSHarmony.getUIAbilityContext().getApplicationContext()
}

// 统一处理 setClickWant 的方法
function handleSetClickWant(want : Want) : void {
	// 如果已经初始化，直接调用setClickWant
	if (IS_INIT && undefined !== APP_KEY) {
		// 冷启动点击通知场景传入 context，避免 SDK 内部 context 未初始化异常（v1.4.0）
		consume(JPushInterface.setClickWant(want, getContext()));
	} else {
		// 如果还没有初始化，保存到数组
		MY_WANT_ARRAY.push(want)
	}
}

// 处理所有保存的 want
function processSavedWants() : void {
	if (MY_WANT_ARRAY.length > 0) {
		MY_WANT_ARRAY.forEach((want) => {
			consume(JPushInterface.setClickWant(want, getContext()));
		})
		MY_WANT_ARRAY = []
	}
}

UTSHarmony.onAppAbilityCreate((want : Want, launchParam : AbilityConstant.LaunchParam) => {
	
	// 使用统一方法处理
	handleSetClickWant(want)
})

UTSHarmony.onAppAbilityNewWant((want : Want, launchParam : AbilityConstant.LaunchParam) => {
	
	// 使用统一方法处理
	handleSetClickWant(want)
})



export function setEventCallBack(param : EventCallBackParams) : void {
	callbackIdentity += 1
	activeCallback?.dispose();
	activeCallback = new CallBackMsgUni(param, () => { refreshCachedPushStopped() })
	JPushInterface.setCallBackMsg(activeCallback!);
}


export const setDebug = function (b : boolean) : void {
	JPushInterface.setDebug(b)
}

// 设置长连接心跳周期
export const setHeartbeatTime = function (heartbeatTime : number) : void {
	JPushInterface.setHeartbeatTime(heartbeatTime)
}

export const setAppKey = function (appKey : string) {
	JPushInterface.setAppKey(appKey)
	APP_KEY = appKey
	
	// 如果已经初始化，处理所有保存的want
	if (IS_INIT) {
		processSavedWants()
	}
}
export const setChannel = function (channel : string) {
	JPushInterface.setChannel(channel)
}

// 配置用户通知权限申请方式
export const setUserRequestNotificationPermission = function (enable : boolean) : void {
	JPushInterface.setUserRequestNotificationPermission(getContext(), enable)
}

// 设置用户分群推送开关
export const setSmartPushEnable = function (enable : boolean) : void {
	const context = getContext()
	JPushInterface.setSmartPushEnable(context, enable)
}

// 设置用户洞察开关
export const setDataInsightsEnable = function (enable : boolean) : void {
	const context = getContext()
	consume(JPushInterface.setDataInsightsEnable(context, enable))
}

export function initAsync(context: common.UIAbilityContext | common.AbilityStageContext | undefined): Promise<void> {
  const generation = upgradeGeneration
  return JPushInterface.init(context ?? UTSHarmony.getUIAbilityContext()).then(() => {
    if (generation != upgradeGeneration) throw new Error('BRIDGE_INVALIDATED')
    IS_INIT = true
    refreshCachedRid(); refreshCachedPushStopped()
    if (APP_KEY != undefined) processSavedWants()
  })
}
export const init = function(context: common.UIAbilityContext | common.AbilityStageContext | undefined): void {
  consume(initAsync(context))
}

// 异步刷新 RID 缓存，注册成功的 onRegister 回调也会更新缓存（见 callback.uts）
function refreshCachedRid() : void {
	consume(getRegistrationIdAsync())
}

// v1.4.0 起底层 SDK 改为异步返回，这里通过缓存保持与 Android/iOS 一致的同步返回；
// 注册完成前可能返回空字符串
export const getRegistrationId = function () : string {
	refreshCachedRid()
	return getCachedRid()
}

export const setCustomMessageMaxCacheCount = function (maxCacheCount : number) {
	JPushInterface.setCustomMessageMaxCacheCount(maxCacheCount)
}


export const stopPush = function () {
	JPushInterface.stopPush();
	refreshCachedPushStopped()
}


export const resumePush = function () {
	JPushInterface.resumePush();
	refreshCachedPushStopped()
}

// 推送停止状态缓存，使 isPushStopped 保持与 Android 一致的同步返回
let CACHED_PUSH_STOPPED : boolean = false

// 异步刷新推送停止状态缓存
function refreshCachedPushStopped() : void {
	consume(isPushStoppedAsync())
}

/**
 * 返回本地缓存状态；v1.4.0 起底层 SDK 改为异步返回，这里通过缓存保持同步返回
 * @deprecated 建议使用 getPushStatus 查询后台实际状态
 */
export const isPushStopped = function () : boolean {
	refreshCachedPushStopped()
	return CACHED_PUSH_STOPPED
}

// 查询后台实际推送状态，结果通过 onCommandResult 事件回调返回
export const getPushStatus = function () : void {
	JPushInterface.getPushStatus();
}

