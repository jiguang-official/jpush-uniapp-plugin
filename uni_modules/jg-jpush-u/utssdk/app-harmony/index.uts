/**
 * 更多插件开发的信息详见：https://uniapp.dcloud.net.cn/plugin/uts-plugin.html
 */

/** These queries return actual SDK results; legacy synchronous getters remain cached. */
export function getRegistrationIdAsync(): Promise<string> {
  const generation = upgradeGeneration
  return JPushInterface.getRegistrationId().then((rid: string): string => {
    if (generation != upgradeGeneration) throw new Error('BRIDGE_INVALIDATED')
    if (rid.length > 0) setCachedRid(rid)
    return rid
  })
}
export function isPushStoppedAsync(): Promise<boolean> {
  const generation = upgradeGeneration
  return JPushInterface.isPushStopped().then((stopped: boolean | undefined): boolean => {
    if (generation != upgradeGeneration) throw new Error('BRIDGE_INVALIDATED')
    if (stopped == undefined) throw new Error('STATUS_UNAVAILABLE')
    CACHED_PUSH_STOPPED = stopped
    return stopped
  })
}
export function turnOffPush(): Promise<PushServiceResult> {
  const generation = upgradeGeneration
  const identity = callbackIdentity
  return JPushInterface.turnOffPush(UTSHarmony.getUIAbilityContext()).then((result): Promise<PushServiceResult> => {
    if (generation != upgradeGeneration) throw new Error('BRIDGE_INVALIDATED')
    return isPushStoppedAsync().catch(() => {
      if (generation != upgradeGeneration) throw new Error('BRIDGE_INVALIDATED')
      bridgeError(generation,identity)
    }).then((): PushServiceResult => {
      if (generation != upgradeGeneration) throw new Error('BRIDGE_INVALIDATED')
      return {code:result.code,msg:result.msg}
    })
  })
}
export function turnOnPush(): Promise<PushServiceResult> {
  JPushInterface.turnOnPush(UTSHarmony.getUIAbilityContext())
  refreshCachedPushStopped()
  return Promise.resolve({dispatched:true} as PushServiceResult)
}
export function requestSubscribeChannels(channels: string[]): Promise<void> { return new Promise<void>((resolve,reject) => { reject(new Error('UNSUPPORTED_PLATFORM')) }) }
export function initCrashHandler(): Promise<void> { return new Promise<void>((resolve,reject) => { reject(new Error('UNSUPPORTED_PLATFORM')) }) }
export function stopCrashHandler(): Promise<void> { return new Promise<void>((resolve,reject) => { reject(new Error('UNSUPPORTED_PLATFORM')) }) }
export function setLiveActivityTokenReportEnabled(enable: boolean): Promise<void> { return new Promise<void>((resolve,reject) => { reject(new Error('UNSUPPORTED_PLATFORM')) }) }
export function registerLiveActivityPushToken(params: LiveActivityPushTokenParams): Promise<LiveActivityResult> { return new Promise<LiveActivityResult>((resolve,reject) => { reject(new Error('UNSUPPORTED_PLATFORM')) }) }
export function registerLiveActivityPushToStartToken(params: LiveActivityPushToStartTokenParams): Promise<LiveActivityResult> { return new Promise<LiveActivityResult>((resolve,reject) => { reject(new Error('UNSUPPORTED_PLATFORM')) }) }
